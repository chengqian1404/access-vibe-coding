# ================================================================
# 直播学习分析器 - 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# ================================================================

# ── 服务器设置 ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8765
DEBUG=true

# ── 数据库 ───────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./storage/app.db

# ── 存储路径 ─────────────────────────────────────────────────────
STORAGE_PATH=./storage
RECORDINGS_PATH=./storage/recordings
ANALYSES_PATH=./storage/analyses
CACHE_PATH=./storage/cache

# ── LLM 提供商选择 ───────────────────────────────────────────────
# 可选值: openai | qwen | claude | deepseek
LLM_PROVIDER=qwen

# ── OpenAI 设置 ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# ── 通义千问 (Qwen) 设置 ─────────────────────────────────────────
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Anthropic Claude 设置 ────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── DeepSeek 设置 ────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Whisper 语音转文字 (使用 OpenAI Whisper API) ──────────────────
# 默认使用 OPENAI_API_KEY，也可单独设置
WHISPER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
